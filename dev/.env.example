# Copy to dev/.env and adjust. dev/.env is git-ignored.
#
# These names are the environment contract shared with ops/: the same
# variables configure a deployment, with different values.

# --- database --------------------------------------------------------------
POSTGRES_DB=groundsource
POSTGRES_USER=groundsource
POSTGRES_PASSWORD=groundsource-local-only
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- backend ---------------------------------------------------------------
# Development value. A deployment must set a real secret; the backend
# refuses to start with this one unless DJANGO_DEBUG is on.
DJANGO_SECRET_KEY=dev-only-insecure-key-do-not-deploy
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_LOG_LEVEL=INFO

# --- ports published on the host ------------------------------------------
API_PORT=8000
WEB_PORT=5173
DB_PORT=5432
