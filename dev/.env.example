# Copy to dev/.env and adjust. dev/.env is git-ignored.
#
# These names are the environment contract shared with ops/: the same
# variables configure a deployment, with different values.

# --- database --------------------------------------------------------------
POSTGRES_DB=groundsource
POSTGRES_USER=groundsource
POSTGRES_PASSWORD=groundsource-local-only
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- backend ---------------------------------------------------------------
# Development value. A deployment must set a real secret; the backend
# refuses to start with this one unless DJANGO_DEBUG is on.
DJANGO_SECRET_KEY=dev-only-insecure-key-do-not-deploy
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_LOG_LEVEL=INFO

# --- model providers -------------------------------------------------------
# Required for ingestion (embeddings) and for answering (chat completion).
# Nothing here is committed: dev/.env is git-ignored, this example is not.
OPENAI_API_KEY=

# Pinned per artifact: every embedding records the model that produced it,
# so changing this invalidates existing embeddings rather than silently
# mixing vector spaces.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# The answering model. Comparable in price to the older mini tier and
# markedly better, so it is the starting point rather than the fallback.
CHAT_MODEL=gpt-5.4-nano

# Hard ceiling on a single answer's generation, as a cost guardrail.
CHAT_MAX_OUTPUT_TOKENS=1200

# --- public access -----------------------------------------------------------
# Origins of the pages allowed to call the API from a browser. Locally the
# pages reach the API through their dev server's /api proxy, so nothing is
# cross-origin and this stays empty.
CORS_ALLOWED_ORIGINS=
# Header carrying the real client address behind a proxy. Empty locally.
CLIENT_IP_HEADER=

# --- usage limits (0 = off, the local default) ------------------------------
# Model calls per UTC day before answers degrade to retrieval-only, and
# questions per client per window. See api/grounding/limits.py.
ASK_DAILY_MODEL_LIMIT=0
ASK_PER_CLIENT_LIMIT=0
ASK_PER_CLIENT_WINDOW_SECONDS=3600

# --- ports published on the host ------------------------------------------
API_PORT=8000
WEB_PORT=5173
ACUERDO_PORT=5174
DB_PORT=5432
