# Copy to ops/tofu/.env and fill in. ops/tofu/.env is git-ignored; this
# template is not, so it holds names only, never values.

# --- state: Cloudflare R2 through the S3 protocol ---------------------------
# An R2 API token with Object Read & Write on the state bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# https://<cloudflare account id>.r2.cloudflarestorage.com
AWS_ENDPOINT_URL_S3=
# Encrypts state and plans. Keep it in a password manager: without it the
# state cannot be read.
TF_VAR_state_passphrase=

# --- Render -----------------------------------------------------------------
RENDER_API_KEY=
# The workspace id (tea-…), not the user id (usr-…). GET /v1/owners lists it.
RENDER_OWNER_ID=

# --- Cloudflare -------------------------------------------------------------
# false deploys the backend alone, before these two exist.
TF_VAR_enable_pages=true
# Token with Account > Cloudflare Pages: Edit.
CLOUDFLARE_API_TOKEN=
TF_VAR_cloudflare_account_id=

# --- OpenAI -----------------------------------------------------------------
# The dedicated GroundSource project's key, prepaid credit, no auto-recharge.
TF_VAR_openai_api_key=

# --- Namecheap (only with TF_VAR_manage_dns=true) ---------------------------
TF_VAR_manage_dns=false
NAMECHEAP_USER_NAME=
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
# This machine's public IP, allowlisted in Namecheap's API settings.
NAMECHEAP_CLIENT_IP=

# --- ingestion window (optional) --------------------------------------------
# JSON list, e.g. ["203.0.113.7/32"]. Empty closes external DB access.
TF_VAR_db_admin_cidrs=[]
