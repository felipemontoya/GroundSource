# ---------------------------------------------------------------------------
# GroundSource working artifacts
# ---------------------------------------------------------------------------
# Derived preparation output is regenerable and is never committed.
# sources/ is deliberately NOT ignored: the original documents are tracked.
/artifacts/
/prepared/
/indexes/
*.embeddings
*.faiss

# Local development state (disposable)
/dev/data/
/dev/.state/
pgdata/
docs/TODO.md

# OpenTofu: provider cache, state and plans. State is kept remotely and
# encrypted; a local copy holds every secret in the deployment.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example

